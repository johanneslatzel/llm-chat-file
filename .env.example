# LLM Chat File — Configuration (example reference)
# Copy to .env and fill in your values.

# --- Workspace access control ---
# Provided by @johannes.latzel/llm-chat-workspace. Native variables are LLM_CHAT_WORKSPACE_*.
# See https://github.com/johanneslatzel/llm-chat-workspace

# --- Search limits ---
# LLM_CHAT_FS_MAX_SEARCH_RESULTS=               # (default: 50)
# LLM_CHAT_FS_MAX_DISPLAY_ENTRIES=              # Threshold to switch from listing paths to count summary (default: 200)
# LLM_CHAT_FS_MAX_TOTAL_ENTRIES=                # Hard limit: abort with error above this (default: 5000)
# LLM_CHAT_FS_SEARCH_TIMEOUT=                   # Total search timeout in milliseconds (default: 10000)

# --- File limits ---
# LLM_CHAT_FS_MAX_CHARS_PER_FILE=               # Maximum characters per file for LLM context (default: 100000)
# LLM_CHAT_FS_MAX_FILE_SIZE=                    # Maximum raw file size in bytes allowed for read operations (default: 10485760, i.e. 10 MB)
# LLM_CHAT_FS_REQUIRE_READ_BEFORE_WRITE=        # Require read_file before write/edit tools (default: true; set "false" to disable)
