# LLM Chat FS — Configuration (example reference)
# Copy to .env and fill in your values.

# --- Filesystem tools ---
# LLM_CHAT_FS_READ_DIRS=                          # Comma-separated directories with read-only access
# LLM_CHAT_FS_WRITE_DIRS=                         # Comma-separated directories with read-write access
# LLM_CHAT_FS_WORKSPACE=                          # Workspace directory (default: current working directory, auto-added as writable)
# LLM_CHAT_FS_MAX_SEARCH_RESULTS=                 # (default: 50)
# LLM_CHAT_FS_MAX_DISPLAY_ENTRIES=                # Threshold to switch from listing paths to count summary (default: 200)
# LLM_CHAT_FS_MAX_TOTAL_ENTRIES=                  # Hard limit: abort with error above this (default: 5000)
# LLM_CHAT_FS_MAX_CHARS_PER_FILE=                 # Maximum characters per file for LLM context (default: 10000)
# LLM_CHAT_FS_MAX_FILE_SIZE=                      # Maximum raw file size in bytes allowed for read operations (default: 10485760, i.e. 10 MB)
# LLM_CHAT_FS_SKIP_DIRS=                          # Comma-separated directory names to skip when walking trees (e.g. node_modules,.git)
# LLM_CHAT_FS_RESOLVE_SYMLINKS=                   # Set to "true" to resolve symlinks before access checks (default: false)
# LLM_CHAT_FS_SEARCH_TIMEOUT=                     # Total search timeout in milliseconds (default: 10000)
